<!-- 订单页 -->
<view class="page">
  <view class="header">
    <text class="header-title">📋 我的订单</text>
    <text class="header-count" wx:if="{{orders.length > 0}}">共 {{orders.length}} 单</text>
  </view>

  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-card card" wx:for="{{orders}}" wx:key="id">
      <view class="order-header">
        <view class="order-info">
          <text class="order-id">订单号：{{item.id.slice(0, 8)}}...</text>
          <text class="order-time">{{item.time}}</text>
        </view>
        <view class="order-status">{{item.status}}</view>
      </view>

      <view class="order-dishes">
        <view class="order-dish" wx:for="{{item.items}}" wx:for-item="d" wx:key="id">
          <text class="order-dish-emoji">{{d.emoji}}</text>
          <text class="order-dish-name">{{d.name}}</text>
          <text class="order-dish-qty">x{{d.quantity}}</text>
          <text class="order-dish-price">¥{{d.price * d.quantity}}</text>
        </view>
      </view>

      <view class="order-total">
        <text>合计</text>
        <text class="order-total-price">¥{{item.total}}</text>
      </view>

      <view class="order-remark" wx:if="{{item.remark}}">
        <text class="remark-label">备注：</text>
        <text>{{item.remark}}</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{orders.length === 0}}">
    <text class="empty-emoji">📭</text>
    <text class="empty-text">还没有订单</text>
    <text class="empty-hint">快去点餐吧～</text>
    <view class="empty-btn" bindtap="goToOrder">去点餐</view>
  </view>
</view>
