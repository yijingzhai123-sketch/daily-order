<!-- 我的页面 -->
<view class="page">
  <view class="user-card">
    <view class="user-bg"></view>
    <view class="user-info">
      <view class="avatar">😊</view>
      <view class="user-text">
        <text class="user-name">{{userName}}</text>
        <text class="user-sub">今天也要好好吃饭哦～</text>
      </view>
    </view>
  </view>

  <view class="stats card">
    <view class="stat-item">
      <text class="stat-num">{{orderCount}}</text>
      <text class="stat-label">订单数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">¥{{totalSpent}}</text>
      <text class="stat-label">累计消费</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{favoriteCat}}</text>
      <text class="stat-label">最爱品类</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-title">常用功能</view>
    <view class="menu-list card">
      <view class="menu-item" bindtap="goToOrders">
        <text class="menu-icon">📋</text>
        <text class="menu-text">我的订单</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToOrder">
        <text class="menu-icon">🍽️</text>
        <text class="menu-text">开始点餐</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="showAbout">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于每日点菜</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="clearAllData">
        <text class="menu-icon">🗑️</text>
        <text class="menu-text">清除所有数据</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="about">
    <text class="about-text">每日点菜 v1.0.0</text>
    <text class="about-text">Made with ❤️</text>
  </view>
</view>
