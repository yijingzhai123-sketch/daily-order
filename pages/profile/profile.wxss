/* 我的页面样式 */
.page {
  min-height: 100vh;
  background: var(--bg);
}

.user-card {
  position: relative;
  padding: 48rpx 28rpx 32rpx;
  overflow: hidden;
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 60rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8C42, #FFB347);
  border-radius: 0 0 48rpx 48rpx;
}

.user-info {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  border: 4rpx solid rgba(255,255,255,0.5);
}

.user-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: white;
}

.user-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

.stats {
  display: flex;
  align-items: center;
  margin: 0 20rpx 24rpx;
  padding: 24rpx 0;
  position: relative;
  z-index: 1;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--secondary);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-lighter);
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: var(--border);
}

.menu-section {
  padding: 0 20rpx;
  margin-bottom: 24rpx;
}

.menu-title {
  font-size: 24rpx;
  color: var(--text-lighter);
  padding: 0 12rpx 12rpx;
}

.menu-list {
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
  gap: 16rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg);
}

.menu-icon {
  font-size: 32rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--secondary);
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-lighter);
  font-weight: 300;
}

.about {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  gap: 8rpx;
}

.about-text {
  font-size: 22rpx;
  color: var(--text-lighter);
}
